# Cadastre estes valores na hospedagem. Nunca envie chaves para o navegador.
# A hospedagem atual já possui a chave interna. Em ambiente novo, gere 32 bytes em hexadecimal; não substitua a chave existente durante a exportação.
AUTH_SESSION_KEY=
PLATFORM_ADMIN_EMAIL=

# Supabase Auth: use a chave PUBLICÁVEL (sb_publishable_...).
# Não use service_role para este fluxo.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PEDIDO_GOOGLE_ENABLED=false
# Marcar true SOMENTE após testar recuperação de senha por e-mail; cadastro não envia mensagem.
PEDIDO_EMAIL_DELIVERY_READY=false
# Cadastro público direto; convite apenas quando solicitado.
# Novas contas não precisam estar na antiga lista de e-mails de teste.
# Exige Supabase com Confirm email desativado; cadastro entra imediatamente.
PEDIDO_AUTH_MODE=public
PEDIDO_AUTH_INVITE_CODE=
PEDIDO_AUTH_TEST_EMAILS=
TURNSTILE_SITE_KEY=

# Ativa confirmação manual de bairro/endereço ANTES do cardápio e Pix.
# Requer drizzle/0007_delivery_approval.sql aplicado e testes reais.
PEDIDO_DELIVERY_APPROVAL_ENABLED=false

# Assinaturas do SaaS, separadas do Pix da pizzaria.
PEDIDO_BILLING_PROVIDER=asaas
PEDIDO_BILLING_ENABLED=false
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
PEDIDO_BILLING_ENFORCED=false
PEDIDO_TRIAL_ENFORCED=false
# Stripe legado, sem ativação simultânea.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PROFISSIONAL=
STRIPE_PRICE_REDE=

# OpenAI: chave no servidor, faturamento da API e teto diário da plataforma.
PEDIDO_AI_ENABLED=false
OPENAI_API_KEY=
PEDIDO_AI_DAILY_LIMIT=100

# Imagens: serviço Lovable separado, sem chave da Lovable no aplicativo principal.
# Permanece desligado em um clone novo; ative somente após configurar o serviço.
PEDIDO_IMAGE_ENABLED=false
PEDIDO_IMAGE_ENDPOINT=https://pedido-on-estudio.lovable.app/api/pedido-on/image

# Estúdio: ativar após publicar a versão nova do serviço Lovable.
PEDIDO_STUDIO_ENABLED=false
PEDIDO_STUDIO_ENDPOINT=https://pedido-on-estudio.lovable.app/api/pedido-on/studio

# Entrada Netlify: estes dois valores são iguais no servidor atual e na Netlify.
# Configure somente quando o domínio Netlify estiver definido. Não é AUTH_SESSION_KEY.
PEDIDO_PUBLIC_ORIGIN=
PEDIDO_PROXY_SECRET=
# Somente na Netlify, disponível em Functions e Edge Functions.
PEDIDO_BACKEND_ORIGIN=https://forno-cardapios.waves4845.chatgpt.site

# Importação pontual autorizada. App distribuído iFood, módulos Merchant e Catalog.
# Ative somente após homologação e teste com loja autorizada.
PEDIDO_IFOOD_ENABLED=false
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=

# Coletor Apify opcional, DESATIVADO. A conexão do chat não fornece esta chave.
# Configure o token SOMENTE como segredo na hospedagem, nunca no navegador/Git.
# VERIFIED só pode virar true após obter e conferir catálogo real desta versão do Actor.
# Limites fixos: uma loja/run, 60 s, maxTotalChargeUsd=0.05 na API,
# 5 tentativas/dia e 20/30 dias na plataforma. Custos de uso da Apify podem ser separados.
# Sem nova tentativa automática em falhas; revisão do dono antes de adicionar produtos.
PEDIDO_APIFY_IFOOD_ENABLED=false
PEDIDO_APIFY_IFOOD_VERIFIED=false
APIFY_TOKEN=
